# Copy to .env (repo root) for `docker compose up`. Never commit .env.
#
# Without Docker (`npm run dev`): put the backend values in backend/.env and
# VITE_CLERK_PUBLISHABLE_KEY in frontend/.env.

# --- Required (the app refuses to start in production without these) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Same publishable key; Vite embeds it into the browser bundle at build time.
VITE_CLERK_PUBLISHABLE_KEY=
IMAGEKIT_PRIVATE_KEY=

# --- Overridden by docker-compose.yml (listed for non-Docker runs) ---
# MONGO_URI=mongodb://127.0.0.1:27017/nextalk
# FRONTEND_URL=http://localhost:3001
# PORT=3001

# --- Optional: the app starts without them, with that feature degraded ---
# Clerk dashboard -> Webhooks. Without it, new users are not synced.
CLERK_WEBHOOK_SIGNING_SECRET=
# @nextalk assistant. Without a key it reports "unavailable".
OPENAI_API_KEY=
# Leave unset for OpenAI. For OpenRouter:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=openrouter/free
# OPENAI_BASE_URL=
# OPENAI_MODEL=